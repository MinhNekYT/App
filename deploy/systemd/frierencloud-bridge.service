[Unit]
Description=FrierenCloud API bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frierencloud
Group=frierencloud
WorkingDirectory=/opt/frierencloud
Environment=PORT=8000
Environment=MOBILE_REDIRECT_URI=frierencloud://auth/discord
LoadCredential=supabase_url:/etc/frierencloud/credentials/supabase_url
LoadCredential=supabase_service_role_key:/etc/frierencloud/credentials/supabase_service_role_key
LoadCredential=github_bridge_token:/etc/frierencloud/credentials/github_bridge_token
LoadCredential=discord_client_id:/etc/frierencloud/credentials/discord_client_id
LoadCredential=discord_client_secret:/etc/frierencloud/credentials/discord_client_secret
LoadCredential=discord_redirect_uri:/etc/frierencloud/credentials/discord_redirect_uri
LoadCredential=session_secret:/etc/frierencloud/credentials/session_secret
ExecStart=/usr/bin/node server/bridge/index.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/frierencloud

[Install]
WantedBy=multi-user.target
